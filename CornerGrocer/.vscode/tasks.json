{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Corner Grocer",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "main.cpp",
                "ItemTracker.cpp",
                "-o",
                "CornerGrocer"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
